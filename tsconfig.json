{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "paths": {
      "optiq-image": [
        "./src/index.ts"
      ],
      "optiq-image/*": [
        "./src/*.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "test",
    "bench",
    "docs/examples"
  ]
}
